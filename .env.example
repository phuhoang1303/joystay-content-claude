# Copy to .env.local and fill in. Never commit .env.local.

# Where SQLite DB, image cache and renders live (gitignored)
DATA_DIR=.data

# AI text provider: claude-cli | anthropic-api | manual
AI_PROVIDER=claude-cli
ANTHROPIC_API_KEY=

# Research
TAVILY_API_KEY=

# Images
GEMINI_API_KEY=
OPENAI_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Hard monthly cap for PAID APIs only (USD)
MONTHLY_PAID_CAP_USD=5

# Google Drive OAuth (Phase 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sanity CMS for joystay.vn blog (Phase 2)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=
SANITY_WRITE_TOKEN=

# Facebook (after MVP)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
